# Copy to .env and fill in. NEVER commit real secrets (.env is gitignored).

# Postgres / Supabase connection — used by BOTH the Python ingestion (writes) and the
# TypeScript engines (read + write scores). Get this from your Supabase project:
#   Supabase dashboard → Project Settings → Database → Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Alias also accepted by the TS layer if you prefer:
# DATABASE_URL=postgresql://...

# (later) Mapbox for the map UI (spec 005)
# NEXT_PUBLIC_MAPBOX_TOKEN=pk....
