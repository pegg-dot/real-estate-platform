# LOT configuration — copy to .env and fill in what you want. Everything is optional for a first run:
# `docker compose up` works with this file untouched (bundled Postgres, no AI, no map).
# NEVER commit .env (it's gitignored). Docker/Railway/Render read these at runtime — no rebuild needed.

# ───────────────────────────── Database ─────────────────────────────
# Leave empty to use the Postgres bundled in docker-compose.yml (persisted in the `lot-db` volume).
# To bring your own Postgres 14+ (Supabase, RDS, Neon, …) paste its connection string here.
# pgvector is optional (enables knowledge embeddings); everything else works without it.
#   Supabase: Project Settings → Database → Connection string (URI), session pooler.
SUPABASE_DB_URL=
# DATABASE_URL=            # accepted as an alias

# ───────────────────────────── Recommended ─────────────────────────────
# Anthropic — powers the chat, the four agents, deal interrogation, the coach, and conversational
# thesis intake. Without it every deterministic part still works: county ingest, scoring, financing
# recommendations, the map, leads, pipeline, brief.   https://console.anthropic.com
ANTHROPIC_API_KEY=

# Mapbox — the /map screen. A free public token (pk.…) from https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=

# ───────────────────────────── App ─────────────────────────────
# LOT_PORT=3000            # host port docker compose publishes (the app listens on 3000 / $PORT inside)
# LOT_MARKET=Charlottesville   # the only market with a county adapter today
# PUBLIC_BASE_URL=https://lot.example.com   # set on a public host: used for OAuth redirect URIs
# ALLOWED_HOSTS=lot.example.com             # optional allowlist when PUBLIC_BASE_URL is unset
# NEXT_PUBLIC_DEV_PASSCODE=lot-dev          # gate for the /dev notes page (not security, just tidiness)
# LOT_SKIP_MIGRATIONS=1                     # container boot: skip the automatic migration step
# LOT_MIGRATE_STRICT=1                      # container boot: exit instead of starting when the DB is unreachable

# ───────────────────────────── Sign-in + Google connectors (optional) ─────────────────────────────
# With AUTH_ENABLED unset the app is single-user with NO login — fine on your laptop or a private
# network; do not expose it to the internet like that. Multi-user needs a Google OAuth client
# (Google Cloud → APIs & Services → Credentials → OAuth 2.0 Web client) with these redirect URIs:
#   <PUBLIC_BASE_URL>/api/auth/google/callback      sign-in
#   <PUBLIC_BASE_URL>/api/connect/google/callback   Gmail send + Calendar connectors
# AUTH_ENABLED=true
# AUTH_SECRET=              # openssl rand -hex 32   (signs the session cookie; changing it logs everyone out)
# AUTH_ALLOWLIST=you@gmail.com,partner@gmail.com    # who may sign in (empty = nobody)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CONNECTOR_SECRET=         # openssl rand -hex 32   (encrypts stored Gmail/Calendar tokens; changing it orphans them)

# ───────────────────────────── Outreach + data vendors (optional) ─────────────────────────────
# OUTREACH_SENDER_ADDRESS="123 Main St, Charlottesville, VA 22903"   # CAN-SPAM: required before any email SEND
# RENTCAST_API_KEY=         # real rent comps (free key at api.rentcast.io); otherwise rents are modeled + flagged
# BATCHDATA_API_KEY=        # skip-trace phones/emails for leads
# ENDATO_NAME=              # Endato contact enrichment (name + key)
# ENDATO_KEY=
# PROBATE_API_KEY=          # probate-lead adapter (stub today)
# HUD_API_TOKEN=            # `python -m ingestion.fmr` live Fair Market Rent fetch (a published fallback is built in)

# ───────────────────────────── Development ─────────────────────────────
# TEST_DATABASE_URL=        # a THROWAWAY Postgres for the DB-integration tests (they're skipped without it)
