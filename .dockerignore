# Keep the build context lean and secrets out of the image. Deps are reinstalled in-image (npm ci + a
# fresh Python venv); env comes from the host at runtime (compose env_file / Railway / Render variables).
.git
node_modules
web/node_modules
.next
web/.next
.env
.env.*
!.env.example
.venv
**/__pycache__
**/*.pyc
*.log
/data
.DS_Store
